# Garnish environment variables: NAMES ONLY. Never commit values.
# Copy to .env.local for local development. On Vercel, set them per environment
# (Production / Preview / Development). Nothing here may use the NEXT_PUBLIC_
# prefix except the public phone number.

# ── Service mode ────────────────────────────────────────────────────────────
# Anything other than a Vercel Production deployment runs in MOCK mode by
# default: no email is sent, leads are kept in memory, chat uses a canned
# local reply. Set to "live" to use the real services outside Production
# (only do this with test credentials and a test inbox).
GARNISH_SERVICES=

# ── Inquiry email (Resend) ──────────────────────────────────────────────────
# Server-side API key (Resend dashboard → API Keys). Sending-only scope.
RESEND_API_KEY=
# Sender on the VERIFIED garnish.info domain, e.g. "Garnish <bookings@send.garnish.info>".
# Required in Production; the Resend sandbox sender is refused there.
CONTACT_FROM=
# Inbox that receives new inquiries. (CONTACT_TO is accepted as an alias.)
ADMIN_EMAIL=

# ── Redis (Upstash, via the Vercel Marketplace) ────────────────────────────
# Used for rate limits and the durable lead store. Either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Secret salt for hashing visitor IPs in rate-limit keys (32+ random chars).
RATE_LIMIT_SALT=
# How long lead records are kept, in days (default 180).
LEAD_RETENTION_DAYS=

# ── Lead recovery (protected cron/admin route) ─────────────────────────────
# Bearer secret (32+ random chars) for /api/leads/recover. The route returns
# 404 until this is set.
CRON_SECRET=

# ── AI concierge upstream ───────────────────────────────────────────────────
# Server-side URL of the AI backend (Production only).
GARNISH_AI_API_URL=
# Optional shared secret sent as X-Garnish-Secret to the upstream. Only useful
# once the AWS side verifies it (owner decision).
GARNISH_AI_SHARED_SECRET=
# Mock mode only: a local mock upstream (http://127.0.0.1:PORT). Optional.
GARNISH_AI_MOCK_URL=

# ── Public ──────────────────────────────────────────────────────────────────
# Phone number shown on the site and in tel: links (public by design).
NEXT_PUBLIC_PHONE_NUMBER=
